@@ -151,6 +151,36 @@ pub trait Engine {
     // ============================================================
     // PROVIDED

+    /// XOR-accumulates eight GF(2^16) scalar multiples of `input` into `outputs`.
+    ///
+    /// Coefficients are field elements, not logarithms; zero leaves its output unchanged.
+    /// Blocks use Leopard layout (32 low bytes followed by 32 high bytes).
+    /// The input is preserved and empty slices are accepted.
+    ///
+    /// # Panics
+    ///
+    /// Panics if any output has a different block count from the input.
+    fn mul_add8(
+        &self,
+        input: &[[u8; 64]],
+        outputs: &mut [&mut [[u8; 64]]; 8],
+        coefficients: &[GfElement; 8],
+    ) {
+        let log = &tables::get_exp_log().log;
+        for (output, &coefficient) in outputs.iter_mut().zip(coefficients) {
+            assert_eq!(output.len(), input.len());
+            if coefficient == 0 {
+                continue;
+            }
+            let log = log[coefficient as usize];
+            for (src, dst) in input.iter().zip(output.iter_mut()) {
+                let mut product = [*src];
+                self.mul(&mut product, log);
+                utils::xor(core::slice::from_mut(dst), &product);
+            }
+        }
+    }
+
     /// Evaluate polynomial.
     fn eval_poly(erasures: &mut [GfElement; GF_ORDER], truncated_size: usize)
     where
@@ -164,3 +194,130 @@ pub trait Engine {
 // TESTS

 // Engines are tested indirectly via roundtrip tests of HighRate and LowRate.
+
+#[cfg(test)]
+mod mul_add8_tests {
+    use super::*;
+    use alloc::{boxed::Box, vec, vec::Vec};
+    use rand::{RngCore, SeedableRng};
+    use rand_chacha::ChaCha8Rng;
+
+    fn engines() -> Vec<Box<dyn Engine>> {
+        let mut engines: Vec<Box<dyn Engine>> = vec![
+            Box::new(Naive::new()),
+            Box::new(NoSimd::new()),
+            Box::new(DefaultEngine::new()),
+        ];
+        #[cfg(any(target_arch = "x86", target_arch = "x86_64"))]
+        {
+            cpufeatures::new!(avx2, "avx2");
+            cpufeatures::new!(ssse3, "ssse3");
+            if avx2::get() {
+                engines.push(Box::new(Avx2::new()));
+            }
+            if ssse3::get() {
+                engines.push(Box::new(Ssse3::new()));
+            }
+        }
+        #[cfg(target_arch = "aarch64")]
+        {
+            cpufeatures::new!(neon, "neon");
+            if neon::get() {
+                engines.push(Box::new(Neon::new()));
+            }
+        }
+        engines
+    }
+
+    #[test]
+    fn matches_scalar_accumulation() {
+        let engines = engines();
+        let tables = tables::get_exp_log();
+        let mut rng = ChaCha8Rng::seed_from_u64(4242);
+        for blocks in [0, 1, 3, 32] {
+            let mut input = vec![[0u8; 64]; blocks];
+            for block in &mut input {
+                rng.fill_bytes(block);
+            }
+            for pattern in 0..3 {
+                if pattern == 1 {
+                    for block in &mut input {
+                        for i in 0..32 {
+                            if i % 7 != 0 {
+                                block[i] = 0;
+                                block[32 + i] = 0;
+                            }
+                        }
+                    }
+                } else if pattern == 2 {
+                    input.fill([0; 64]);
+                }
+                for coefficients in [[0; 8], [1; 8], [0, 1, 65535, 1234, 0, 32768, 91, 65534]] {
+                    let original_input = input.clone();
+                    let initial: [Vec<[u8; 64]>; 8] = core::array::from_fn(|_| {
+                        (0..blocks)
+                            .map(|_| {
+                                let mut block = [0; 64];
+                                rng.fill_bytes(&mut block);
+                                block
+                            })
+                            .collect()
+                    });
+                    for engine in &engines {
+                        let mut actual = initial.clone();
+                        let mut expected = initial.clone();
+                        for _ in 0..2 {
+                            for (block, src) in input.iter().enumerate() {
+                                for i in 0..32 {
+                                    let symbol = u16::from_le_bytes([src[i], src[32 + i]]);
+                                    for (dst, &coefficient) in
+                                        expected.iter_mut().zip(&coefficients)
+                                    {
+                                        let product = if symbol == 0 || coefficient == 0 {
+                                            0
+                                        } else {
+                                            tables.exp[(usize::from(
+                                                tables.log[usize::from(symbol)],
+                                            ) + usize::from(
+                                                tables.log[usize::from(coefficient)],
+                                            )) % 65535]
+                                        };
+                                        let bytes = product.to_le_bytes();
+                                        dst[block][i] ^= bytes[0];
+                                        dst[block][32 + i] ^= bytes[1];
+                                    }
+                                }
+                            }
+                            let mut outputs = actual.each_mut().map(Vec::as_mut_slice);
+                            engine.mul_add8(&input, &mut outputs, &coefficients);
+                            assert_eq!(actual, expected, "blocks={blocks}, pattern={pattern}");
+                            assert_eq!(input, original_input);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    fn mismatched_output(engine: &impl Engine) {
+        let mut outputs: [Vec<[u8; 64]>; 8] = core::array::from_fn(|_| vec![[0; 64]]);
+        outputs[7].clear();
+        engine.mul_add8(
+            &[[1; 64]],
+            &mut outputs.each_mut().map(Vec::as_mut_slice),
+            &[0; 8],
+        );
+    }
+
+    #[test]
+    #[should_panic(expected = "assertion `left == right` failed")]
+    fn portable_rejects_mismatched_output() {
+        mismatched_output(&NoSimd::new());
+    }
+
+    #[test]
+    #[should_panic(expected = "assertion `left == right` failed")]
+    fn default_rejects_mismatched_output() {
+        mismatched_output(&DefaultEngine::new());
+    }
+}
